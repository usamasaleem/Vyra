{
  "name": "@vyra/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../inbox/.env.local src/index.ts",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "start": "node --env-file-if-exists=../inbox/.env.local dist/index.js",
    "failures": "tsx --env-file-if-exists=../inbox/.env.local src/cli/failures.ts",
    "simulate": "tsx --env-file-if-exists=../inbox/.env.local src/cli/simulate.ts"
  },
  "dependencies": {
    "graphile-worker": "^0.18.0",
    "@vyra/contracts": "*",
    "@vyra/db": "*",
    "@vyra/agent": "*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
