# Copy to .env.local and fill in. Never commit the filled copy.

NODE_ENV=development

# Supabase PostgreSQL.
# Use the pooled connection string for the app, the direct one for migrations.
DATABASE_URL=

# --- Meta app-level (one per Meta app) ---
# Any string you choose; must match what you enter in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret. Verifies the X-Hub-Signature-256 HMAC over the raw body.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v26.0

# --- Pilot operator channel (moves into whatsapp_accounts before operator 2) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- The AI turn ---
# Without a key the worker still boots, ingests, dispatches staff replies and
# honours opt-outs. It just runs no AI turn.
OPENAI_API_KEY=

# Chosen by the eval sweep on 14 September 2026, not by reputation:
# gpt-5.6-luna scored identically at low, medium and high across all 28 cases,
# so the cheapest of those is the one to pay for. Re-run `npm run evals:compare`
# before changing either.
AI_MODEL=gpt-5.6-luna
AI_REASONING_EFFORT=low

# Two switches, and they answer different questions.
#
# AI_SENDING_ENABLED decides whether a turn runs at all — the system-wide kill
# switch. Ingestion and staff replies keep working when it is false.
#
# AI_AUTOSEND_ENABLED decides what happens to a reply the turn produced: send
# it, or write it as an internal note for a person to read (shadow mode, build
# plan step 33). Notes have no path to the dispatcher, so a shadow draft cannot
# reach a customer at all.
#
# Both stay false until shadow mode has been reviewed. Reaching a customer
# should take a deliberate act.
#
# There is a THIRD switch, and it is not in this file: operators.ai_sending_enabled,
# a column per operator. All three must allow a turn before one runs. This cost
# half an hour once — the env switch was on, the column was not, and the log
# said "operator_ai_disabled" while everything else looked correct.
AI_SENDING_ENABLED=false
AI_AUTOSEND_ENABLED=false

# --- Supabase Auth (staff identity) ---
# Publishable keys are designed to be visible in a browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
